PORT=5001
MONGO_URI=mongodb://localhost:27017
DB_NAME=hospital_ai_blockchain
USE_IN_MEMORY_MONGO=false

# Required in production: set a strong, unique secret.
JWT_SECRET=change_this_secret

CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ENABLE_DEBUG_ROUTES=false
ALLOW_DEMO_CREDENTIALS=false

# OTP email transport
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@aihealthcare.local

# Google OAuth (optional). Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI / LLM Configuration (FastAPI chatbot)
# Example: http://127.0.0.1:8000
FASTAPI_BASE_URL=http://127.0.0.1:8000
# Example: /chat
FASTAPI_CHAT_PATH=/api/chat
# Request timeout in ms
FASTAPI_TIMEOUT_MS=15000

# Required in production: set a strong, unique password.
BACKUP_PASSWORD=change_this_backup_password

# Optional archive config
ARCHIVE_BEFORE_DAYS=365
ARCHIVE_BATCH_SIZE=500

